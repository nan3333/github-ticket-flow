{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ticket research handoff",
  "type": "object",
  "additionalProperties": true,
  "required": ["github_issue", "repository", "researched_against", "status", "problem", "scope", "code_map", "implementation", "verification", "risks"],
  "properties": {
    "github_issue": {"type": "integer", "minimum": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "researched_against": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"enum": ["ready", "blocked", "needs-clarification"]},
    "problem": {
      "type": "object",
      "required": ["observed_behavior", "expected_behavior", "root_cause"],
      "properties": {
        "observed_behavior": {"type": "string"},
        "expected_behavior": {"type": "string"},
        "root_cause": {"type": "string"},
        "stale_ticket_corrections": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scope": {
      "type": "object",
      "required": ["required", "excluded"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}},
        "excluded": {"type": "array", "items": {"type": "string"}}
      }
    },
    "code_map": {
      "type": "object",
      "required": ["owner_symbols", "callers", "existing_patterns"],
      "properties": {
        "owner_symbols": {"type": "array", "items": {"type": "string"}},
        "callers": {"type": "array", "items": {"type": "string"}},
        "existing_patterns": {"type": "array", "items": {"type": "string"}}
      }
    },
    "implementation": {
      "type": "object",
      "required": ["minimal_plan", "likely_files"],
      "properties": {
        "minimal_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "likely_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object",
      "required": ["red_test", "focused_gates", "final_gates"],
      "properties": {
        "red_test": {"type": ["string", "null"]},
        "focused_gates": {"type": "array", "items": {"type": "string"}},
        "final_gates": {"type": "array", "items": {"type": "string"}}
      }
    },
    "risks": {
      "type": "object",
      "required": ["residual"],
      "properties": {
        "security": {"type": "array", "items": {"type": "string"}},
        "migration": {"type": "array", "items": {"type": "string"}},
        "public_api": {"type": "array", "items": {"type": "string"}},
        "residual": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
